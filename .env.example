# ---------------------------------------------------------------------------
# LOUD JAKARTA — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# PUBLIC — inlined into the browser bundle. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public by design: used to build wa.me links. Digits only, international
# format without "+", spaces or dashes (e.g. 6281234567890).
# Leave empty until the owner provides the real number.
NEXT_PUBLIC_DEFAULT_WHATSAPP_NUMBER=

# Official Instagram profile URL. Leave empty until the owner provides it;
# the UI shows an honest "coming soon" state instead of a fake link.
NEXT_PUBLIC_INSTAGRAM_URL=

# Optional Cloudflare Turnstile (anti-spam). Leave both empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefix these with NEXT_PUBLIC_ and never import them
# from a Client Component.
# ---------------------------------------------------------------------------

# Supabase secret key. Bypasses Row Level Security. Server-side only.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Long random string used to hash submitter IP addresses for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=replace-with-a-long-random-string

# Optional Cloudflare Turnstile secret. Required only if the site key is set.
TURNSTILE_SECRET_KEY=

# Upload limits (megabytes per proof image).
GUESTLIST_MAX_FILE_MB=5

# Shared secret for the scheduled orphan cleanup route
# (`/api/cron/cleanup-orphans`). Vercel Schedules sends it as
# `Authorization: Bearer <CRON_SECRET>`. Minimum 16 characters; generate with
# the same command as RATE_LIMIT_SALT. Leave empty locally unless you are
# testing the route — the route refuses to run without it.
CRON_SECRET=
